*/
(header "symbol" (version "1.2"))
(symbol
	(rect 0 0 160 80)
	(text "pll_25mhz" (rect 5 0 68 12)(font "Arial" (font_size 10)))
	(text "inst" (rect 8 64 36 76)(font "Arial" ))
	(port
		(pt 0 32)
		(input)
		(text "inclk0" (rect 0 0 42 12)(font "Arial" ))
		(text "inclk0" (rect 21 27 63 39)(font "Arial" ))
		(line (pt 0 32)(pt 16 32)(line_width 1))
	)
	(port
		(pt 160 32)
		(output)
		(text "c0" (rect 0 0 14 12)(font "Arial" ))
		(text "c0" (rect 125 27 139 39)(font "Arial" ))
		(line (pt 160 32)(pt 144 32)(line_width 1))
	)
	(port
		(pt 160 48)
		(output)
		(text "locked" (rect 0 0 42 12)(font "Arial" ))
		(text "locked" (rect 97 43 139 55)(font "Arial" ))
		(line (pt 160 48)(pt 144 48)(line_width 1))
	)
